# Copy to .env (git-ignored). The API and worker load the nearest .env on
# startup (searching upward from the process dir), so a single repo-root .env is
# picked up regardless of which package you start. Exported shell vars override .env.

# --- Database ---
# Use 127.0.0.1 (IPv4) — 'localhost' may resolve to a local Postgres on ::1.
# The host port must match POSTGRES_HOST_PORT below.
DATABASE_URL=postgresql://infra:infra@127.0.0.1:55432/infra_explorer
# Host port the Postgres container publishes (avoids clashing with a local 5432).
POSTGRES_HOST_PORT=55432

# --- AWS base credentials (the platform's OWN identity used to call AssumeRole) ---
# The SDK's default credential chain is used. Point it at a profile:
AWS_PROFILE=my-base-account
# ...or set keys directly instead of a profile (not recommended):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Region for the STS AssumeRole client + default scan region.
AWS_REGION=us-west-2

# In production the API/worker run with an ECS task role — set no keys/profile here.
# Worker role ARN that target accounts must trust (shown on the connect screen).
# Leave empty for local dev (you assume target roles from your own identity).
CONTROL_WORKER_ROLE_ARN=

# --- API ---
API_PORT=4000
# Comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js reads its own apps/web/.env; this is for reference) ---
# NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# --- Logging ---
LOG_LEVEL=info
# "pretty" for human-readable local logs, "json" for structured production logs.
LOG_FORMAT=pretty
