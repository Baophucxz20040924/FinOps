# --- Database ---
DATABASE_URL=postgresql://infra:infra@localhost:5432/infra_explorer

# --- API ---
API_PORT=4000
# Comma-separated origins allowed to call the API (frontend)
CORS_ORIGINS=http://localhost:3000

# --- AWS (control account / platform identity) ---
# In local dev the SDK uses your default AWS profile / env credentials.
# In production the API + worker run with an ECS task role and set no keys here.
AWS_REGION=us-west-2

# --- Logging ---
LOG_LEVEL=info
# "pretty" for human-readable local logs, "json" for structured production logs
LOG_FORMAT=pretty
