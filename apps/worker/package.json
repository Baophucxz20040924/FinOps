{
  "name": "@infra-explorer/worker",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@infra-explorer/aws-scanner": "workspace:*",
    "@infra-explorer/db": "workspace:*",
    "@infra-explorer/domain": "workspace:*",
    "@infra-explorer/relationship-engine": "workspace:*",
    "@infra-explorer/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg-boss": "^10.1.6"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
